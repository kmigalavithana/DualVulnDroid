<idea-plugin>
    <id>com.dualvulndroid.DualVulnDroid</id>
    <name>DualVulnDroid</name>
    <vendor>DualVulnDroid Research Team</vendor>

    <description><![CDATA[
    DualVulnDroid - Android vulnerability detector plugin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="DualVulnDroid"
                factoryClass="com.dualvulndroid.dualvulndroid.MyToolWindowFactory"
                icon="AllIcons.Toolwindows.ToolWindowPalette"/>

        <externalAnnotator
                language="XML"
                implementationClass="com.dualvulndroid.dualvulndroid.NetworkSecurityAnnotator"/>

        <externalAnnotator
                language="kotlin"
                implementationClass="com.dualvulndroid.dualvulndroid.CodeSentinelAnnotator"/>
        <externalAnnotator
                language="JAVA"
                implementationClass="com.dualvulndroid.dualvulndroid.CodeSentinelAnnotator"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <actions>
        <action id="DualVulnDroid.RescanCurrentFile"
                class="com.dualvulndroid.dualvulndroid.RescanCurrentFileAction"
                text="DualVulnDroid: Rescan Current File"
                description="Re-scan this file's current editor content against the DualVulnDroid backend">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>