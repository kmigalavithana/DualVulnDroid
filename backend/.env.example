# Copy this file to .env and fill in real values. .env itself must
# never be committed (see .gitignore).

# MySQL connection string. Required - there is no SQLite fallback.
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL=mysql+pymysql://dualvulndroid:CHANGE_ME@localhost:3306/dualvulndroid

# Secret used to sign JWTs. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a value from documentation/examples in production.
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Optional - defaults to 43200 (30 days) if unset.
JWT_EXPIRE_MINUTES=43200

API_HOST=127.0.0.1
API_PORT=8000

# P0 Step 9 - optional. Maximum size, in bytes (measured as UTF-8 byte
# length of the "code" field only), that POST /predict will accept before
# rejecting with 413 Payload Too Large, without ever running feature
# extraction/XGBoost/SHAP/data-flow analysis on the oversized input.
# Defaults to 200000 (~200KB) if unset - comfortably larger than any
# realistic single Android Java/Kotlin source file, while still refusing
# arbitrarily large payloads. Does not affect /developer/predict's
# separate, already-existing MAX_CODE_SIZE_BYTES guard.
PREDICT_MAX_CODE_SIZE_BYTES=200000

# Optional - only needed if you maintain a SEPARATE MySQL database for
# running the integration tests in tests/test_db_integration.py (Part V:
# "do not use the production database for tests"). Falls back to
# DATABASE_URL if unset. Tests are skipped, not failed, when neither
# variable points at a reachable MySQL server.
TEST_DATABASE_URL=mysql+pymysql://dualvulndroid:CHANGE_ME@localhost:3306/dualvulndroid_test

# Required for SmartApp's real Google Play data routes (/smartapp/apps/*)
# only - unrelated to the security-detection endpoints above. Get a key
# at https://serpapi.com/. Never hardcode this in source, never commit
# the real value (only this .env.example placeholder is tracked by git -
# see backend/smartapp/provider.py, the only module that reads it).
SERPAPI_API_KEY=CHANGE_ME_YOUR_SERPAPI_KEY

# --- SmartApp verified-metadata enrichment (all optional) ---
# Exodus tracker reports. Exodus asks end-user products to run their own
# instance: point EXODUS_BASE_URL at it. Without both values, privacy data
# is simply shown as "Not verified". Never commit a real token.
EXODUS_BASE_URL=
EXODUS_API_TOKEN=
# F-Droid open-source metadata (public, no key). Set to 0 to disable.
SMARTAPP_FDROID_ENABLED=1
# How many search results also fetch their Google Play product page
# (price / "Contains ads"). Each costs ONE SerpApi credit per new app
# (cached 24h). 0 = only on the App Details screen.
SMARTAPP_SEARCH_DETAILS_LIMIT=0
