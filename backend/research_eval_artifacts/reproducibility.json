{
  "model": "microsoft/codebert-base",
  "strategy": "C_full_finetune",
  "dataset": "clean_dataset.csv",
  "dataset_rows": 1128,
  "train_size": 791,
  "validation_size": 169,
  "test_size": 168,
  "seed": 42,
  "max_length": 79,
  "label_mapping": {
    "s0": 0,
    "v0": 1,
    "s1": 2,
    "v1": 3
  },
  "batch_size": 8,
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "epochs_max": 5,
  "early_stopping_patience": 2,
  "device": "cuda",
  "gpu": "Tesla T4",
  "torch_version": "2.11.0+cu128"
}